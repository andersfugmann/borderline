# EXPECT-COUNT: 1 => log prefix "common-first: "
# EXPECT-COUNT: 1 => log prefix "common-second: "
# EXPECT-COUNT: 1 => log prefix "common-third: "
# EXPECT-COUNT: 1 => log prefix "left-only: "
# EXPECT-COUNT: 1 => log prefix "right-only: "

process filter {
    rule {
        source interface_group = 1;
        rule {
            destination tcp port = 9991;
        } policy { log "left-only"; allow; };
        rule {
            destination tcp port = 10001;
        } policy { log "common-first"; allow; };
        rule {
            destination tcp port = 10002;
        } policy { log "common-second"; allow; };
        rule {
            destination tcp port = 10003;
        } policy { log "common-third"; allow; };
    } policy deny;
    rule {
        source interface_group = 2;
        rule {
            destination tcp port = 9992;
        } policy { log "right-only"; allow; };
        rule {
            destination tcp port = 10001;
        } policy { log "common-first"; allow; };
        rule {
            destination tcp port = 10002;
        } policy { log "common-second"; allow; };
        rule {
            destination tcp port = 10003;
        } policy { log "common-third"; allow; };
    } policy deny;
} policy deny
